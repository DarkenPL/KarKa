{
  "name": "karka",
  "productName": "KarKa",
  "version": "0.7.18",
  "nazwaWydania": "Pieczęć lakowa",
  "description": "KarKa (Kawia Karciana) – generator kart do gier: karty z arkusza CSV/XLSX i szablonu tekstowego",
  "main": "start.js",
  "private": true,
  "scripts": {
    "zasoby": "node scripts/zasoby.js",
    "start": "npm run zasoby && electron .",
    "dist": "npm run zasoby && electron-builder --mac --dir"
  },
  "devDependencies": {
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "html-to-image": "1.11.11",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "xlsx": "0.18.5"
  },
  "build": {
    "appId": "io.github.generatorkart",
    "productName": "KarKa",
    "copyright": "KarKa – Kawia Karciana",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "start.js",
      "nakladka.js",
      "main.js",
      "preload.js",
      "zakladki.html",
      "preload-zakladki.js",
      "serwer.js",
      "historia.js",
      "drukarnia.js",
      "cmyk.js",
      "drukarnie.js",
      "drukarnie/longpack.json",
      "drukarnie/printnet.json",
      "aktualizacje.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "zasoby",
        "to": "zasoby"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        "dir"
      ],
      "extendInfo": {
        "CFBundleDevelopmentRegion": "pl",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Szablon kart",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.plain-text"
            ]
          }
        ]
      }
    },
    "publish": null,
    "dmg": {
      "artifactName": "KarKa.${ext}",
      "title": "KarKa",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DarkenPL/KarKa.git"
  }
}
